{
  "manifest_version": 3,
  "name": "SyncYouTube",
  "version": "1.2.1",
  "description": "Schickt YouTube-Videos per Rechtsklick oder ⬇-Knopf an SyncYouTube auf dem eigenen PC (127.0.0.1:8776). Läuft die App nicht, merkt sich das Add-on die Klicks und reiht sie beim nächsten Start ein.",
  "permissions": ["contextMenus", "storage", "notifications", "alarms"],
  "host_permissions": ["http://127.0.0.1:8776/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SyncYouTube",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
